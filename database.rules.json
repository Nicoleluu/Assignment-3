{
  "rules": {
    ".read": false,
    ".write": false,
    "polls": {
      "dcm-setting": {
        "options": {
          ".read": true,
          "$choice": {
            ".write": "$choice === 'workspace' || $choice === 'dining' || $choice === 'reading' || $choice === 'gallery'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
          }
        }
      }
    }
  }
}
